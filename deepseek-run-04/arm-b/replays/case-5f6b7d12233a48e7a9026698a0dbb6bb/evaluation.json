      "patch_payload": {
        "candidate_id": "C_e797e47ec37426c0_0",
        "edit": "Change the level-sensitive latch always@(clk) with blocking assignment q = d to an edge-triggered always@(posedge clk) with nonblocking assignment q <= d, so q captures d on the clock edge instead of following d combinationally.",
        "lens_id": "generic_v1",
        "replacement_rtl": "module latch24_test( d, clk,q );\n\t\n    input [23:0] d;\n    input clk;\n    output[23:0] q;\n    reg [23:0] q;\n    always@ (posedge clk)\n        q <= d;\n\nendmodule\n",
        "slot_index": 0
      },
