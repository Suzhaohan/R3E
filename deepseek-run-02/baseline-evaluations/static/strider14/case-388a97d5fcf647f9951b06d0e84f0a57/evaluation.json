      "patch_payload": {
        "candidate_id": "C_8b8e0d96a63b97ac_0",
        "edit": "Fix active-low reset polarity: change 'if (rstn)' to 'if (!rstn)' so q is cleared to 0 when rstn is low, matching the oracle expectation at cycle 1.",
        "lens_id": "generic_v1",
        "replacement_rtl": "module tff (   input clk,\n               input \t  rstn,\n               input \t  t,\n               output reg q);\n   \n   always @ (posedge clk) begin\n      \n      if (!rstn)\n\t q <= 0;\n      else if (t)\n\t q <= ~q;\n      else\n\t q <= q;\n      \n   end\nendmodule\n",
        "slot_index": 0
      },
      "patch_payload_hash": "sha256:caa7ede23e30fec88384ef23840d50ef255018f5a782dbf0d0095b9e12e0eb77",
