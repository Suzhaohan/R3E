      "slot_index": 0,
      "toolchain_fingerprint_hash": "sha256:2d19a35aec0b19b824a1d998de7f97bfdf13bcf674787e9ea43d20072193f40f",
      "verifier_hash": "sha256:14366b5e5f31840f68bf4bb3be54fd438c2d80b562b164eaa770c89cf32aa933"
    },
