      "current_case_artifact_hash": "sha256:c078b325b4ad530c48505fd4370247137324baa8a4d57c3b02af96183039a86b",
      "current_case_evidence_hash": "sha256:35735cccff4e7ac27d3fd90e5334221433952fbb43d26b3d2c8674ad12f0d3a7",
      "input_tokens": 843,
      "lens_hash": "sha256:8bee2140b4b790f5e068e290890baf036abd4746730e1df4485e5270e70e456c",
