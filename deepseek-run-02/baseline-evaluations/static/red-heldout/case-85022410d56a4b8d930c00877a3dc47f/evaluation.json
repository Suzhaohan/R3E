        "replacement_rtl": "module counter6bit_test(ENA,CLR,F_IN,Q);\n    input ENA;\n    input CLR;\n    input F_IN;\n    output [23:0] Q;\n\n    reg [23:0] Q;\n    reg [19:0] temp_bcd=1;\n    reg F_OUT;\n\n    always @(posedge F_IN)\n    begin\n    if(CLR == 1) Q<=0;\n    else\n    begin\n    if(ENA==1)\n    begin\n    if(Q[3:0]==4'b1001)\n    begin\n    temp_bcd=temp_bcd+1;\n    Q<={temp_bcd,4'b0000};\n    end\n    else if(Q[7:0]==8'b10011001) Q<=0;\n    else Q<=Q+1;\n    end\n    end\n  end\n  endmodule",
