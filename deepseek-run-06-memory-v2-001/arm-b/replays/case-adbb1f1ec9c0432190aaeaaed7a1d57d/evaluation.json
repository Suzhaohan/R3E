      "patch_payload": {
        "candidate_id": "C_e133d2d6db2e1cbe_2",
        "edit": "Invert the enable condition: change `if(ena)` to `if(!ena)` so that y is forced to 0 when ena is low, matching the expected output at cycle 0 (00000000).",
