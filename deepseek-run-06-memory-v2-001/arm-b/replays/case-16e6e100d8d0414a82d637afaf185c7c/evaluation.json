        "edit": "Convert the level-sensitive latch to a positive-edge-triggered flip-flop by gating the assignment with 'if (clk)' inside the always@(clk) block, so q updates only on the rising edge of clk instead of continuously while clk is high.",
        "lens_id": "dataflow_v1",
        "replacement_rtl": "module latch24_test( d, clk,q );\n\t\n    input [23:0] d;\n    input clk;\n    output[23:0] q;\n    reg [23:0] q;\n    always@ (clk)\n        if (clk)\n            q = d;\n\nendmodule\n",
        "slot_index": 1
