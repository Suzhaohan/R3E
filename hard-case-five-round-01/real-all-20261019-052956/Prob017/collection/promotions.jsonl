ss"}, "transfer_summary": {"changed_lines": ["-", "-            clk_cnt <= clk_cnt==(div_o-1)? 0: clk_cnt+2;", "+            clk_cnt <= clk_cnt==(div_o-1)? 0: clk_cnt+1;", "-endmodule", "+endmodule"], "checks_on_transfer": ["Trace pre-edge counter/mode values before altering registered output timing.", "Recheck both even/odd period modes, finite-width counter wraps and the public parameterized waveform contract.", "Preserve asynchronous reset and parameter declarations; do not generalize one repaired constant to every divider expression."], "scope": "Observed public success only; recheck applicability on a new task."}}}}], "state_hash": "sha256:c1e15c869cc3aa45ab0ef314f535e1ed62d586939caae2c954243d67927afcc4"}, "losses": [], "gains": [], "incumbent_passed": 2, "candidate_passed": 2, "scheduled_pairs": 4, "incumbent_scores": {"sha256:446b7366de3dc32003c8205b807d293e5487d3886891d7d5e462e7a57689a8cf:0": false, "sha256:446b7366de3dc32003c8205b807d293e5487d3886891d7d5e462e7a57689a8cf:1": false, "sha256:c17b1a5e88f019b636d8349acee524f74e7da7a1c1d7db628482a6c8c4318586:0": true, "sha256:c17b1a5e88f019b636d8349acee524f74e7da7a1c1d7db628482a6c8c4318586:1": true}, "candidate_scores": {"sha256:446b7366de3dc32003c8205b807d293e5487d3886891d7d5e462e7a57689a8cf:0": false, "sha256:446b7366de3dc32003c8205b807d293e5487d3886891d7d5e462e7a57689a8cf:1": false, "sha256:c17b1a5e88f019b636d8349acee524f74e7da7a1c1d7db628482a6c8c4318586:0": true, "sha256:c17b1a5e88f019b636d8349acee524f74e7da7a1c1d7db628482a6c8c4318586:1": true}, "incumbent_cache_path": "/data2/huangyc/R3E-aic-ic-2026-latest/hard-case-five-round-01/real-all-20261019-052956/Prob017/collection/validation_baseline.json", "incumbent_cache_hash": "sha256:f104400c4053b03dffc35e8b5f5a042a3c18f84fc3272a1eafec155cff970073", "retained_state_hash": "sha256:442d94b205c17d4aca36d03eb212da18bfff1beb6460ee65b8e2eb0540486de1", "certificates": ["sha256:c17b1a5e88f019b636d8349acee524f74e7da7a1c1d7db628482a6c8c4318586:0", "sha256:c17b1a5e88f019b