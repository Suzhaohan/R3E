e dispensing: Only 0.5 yuan coins are dispensed as change\n\nCurrency input behavior:\n- Input currency signals (d1, d2) are automatically edge-detected\n- Each currency input produces a pulse signal that goes high on clock\n  rising edge and low on clock falling edge\n- The machine accum", "applied_patch": "--- a/rtl/sequence.sv\n+++ b/rtl/sequence.sv\n@@ -32,7 +32,7 @@\n                               nstate;\n             S1     : nstate = d1? S1_5:\n                               d2? S2:\n-                              S0;\n+                              nstate;\n             S1_5   : nstate = ~sel? S0:\n                               d1? S2:\n                               d2? S2_5:\n", "public_rows": {"W_bug": "visible_pass", "W_preserve": "visible_pass"}}}}], "state_hash": "sha256:1958cc6b73da585320a1075df4ba616cb0bea5cf9c006f4547feb8a9c3573116"}, "losses": ["sha256:d89a35ed58aad06467f3becaaca107c476db79779a22996b8dbd38c4b79adb1e:0"], "gains": ["sha256:24cbc7f79d10e617632a30ccbcf186b88c7577a8d34e05de149c420d432ed852:0", "sha256:24cbc7f79d10e617632a30ccbcf186b88c7577a8d34e05de149c420d432ed852:1"], "incumbent_passed": 2, "candidate_passed": 3, "scheduled_pairs": 4, "incumbent_scores": {"sha256:d89a35ed58aad06467f3becaaca107c476db79779a22996b8dbd38c4b79adb1e:0": true, "sha256:d89a35ed58aad06467f3becaaca107c476db79779a22996b8dbd38c4b79adb1e:1": true, "sha256:24cbc7f79d10e617632a30ccbcf186b88c7577a8d34e05de149c420d432ed852:0": false, "sha256:24cbc7f79d10e617632a30ccbcf186b88c7577a8d34e05de149c420d432ed852:1": false}, "candidate_scores": {"sha256:d89a35ed58aad06467f3becaaca107c476db79779a22996b8dbd38c4b79adb1e:0": false, "sha256:d89a35ed58aad06467f3becaaca107c476db79779a22996b8dbd38c4b79adb1e:1": true, "sha256:24cbc7f79d10e617632a30ccbcf186b88c7577a8d34e05de149c420d432ed852:0": true, "sha256:24cbc7f79d10e617632a30ccbcf186b88c7577a8d34e05de149c420d432ed852:1": true}, "incumbent_cache_path": "/data2/huangyc/R3E-aic-ic-2026-latest/hard-case-five-round-01/real-all-20261