   cyc_cnt <= cyc_cnt==(M_N-1)? 0: cyc_cnt+1;\n+            cyc_cnt <= (cyc_cnt == (M_N-1)) ? 0 : cyc_cnt + 1;\n     end\n     \n     always@(posedge clk_in or negedge rst) begin\n         if(~rst)\n             div_flag <= 0;\n         else\n-            div_flag <= cyc_cnt==(M_N-1)||cyc_cnt==(c89-1)? ~div_flag: div_flag;\n+            div_flag <= (cyc_cnt == (M_N-1) || cyc_cnt == (c89-1)) ? ~div_flag : div_flag;\n     end\n     \n     always@(posedge clk_in or negedge rst) begin\n         if(~rst)\n             clk_out_r <= 0;\n         else if(~div_flag)\n-            clk_out_r <= clk_cnt<=((div_e>>2)+1);\n+            clk_out_r <= (clk_cnt <= ((div_e>>2)+1));\n         else\n-            clk_out_r <= clk_cnt<=((div_o>>2)+1);\n+            clk_out_r <= (clk_cnt <= ((div_o>>2)+1));\n     end\n     \n     assign clk_out = clk_out_r;\n //*************code***********//\n-endmodule\n+endmodule", "public_rows": {"W_bug": "visible_pass", "W_preserve": "visible_pass"}, "transfer_summary": {"changed_lines": ["-", "-            clk_cnt <= clk_cnt==(div_e-1)? 0: clk_cnt+2;", "+            clk_cnt <= (clk_cnt == (div_e-1)) ? 0 : clk_cnt + 1;", "-            clk_cnt <= clk_cnt==(div_o-1)? 0: clk_cnt+1;", "+            clk_cnt <= (clk_cnt == (div_o-1)) ? 0 : clk_cnt + 1;", "-            cyc_cnt <= cyc_cnt==(M_N-1)? 0: cyc_cnt+1;"], "checks_on_transfer": [], "scope": "Observed public success only; recheck applicability on a new task."}}}}], "state_hash": "sha256:60b6a86e65972711d5f74e19a443786b8a676879468f8b8a5e37baaedbe1e9e1"}, "losses": [], "gains": [], "incumbent_passed": 4, "candidate_passed": 4, "scheduled_pairs": 4, "incumbent_scores": {"sha256:446b7366de3dc32003c8205b807d293e5487d3886891d7d5e462e7a57689a8cf:0": true, "sha256:446b7366de3dc32003c8205b807d293e5487d3886891d7d5e462e7a57689a8cf:1": true, "sha256:c17b1a5e88f019b636d8349acee524f74e7da7a1c1d7db628482a6c8c4318586:0": true, "sha256:c17b1a5e88f019b636d8349acee524f74e7da7a1c1d7db628482a6c8c4318586:1": true}, "candida