        "replacement_rtl": "module mux21(a,b,s,y);\n\tinput a,b,s;\n\toutput y;\n\treg y;\n\talways @(a,b,s)\n    begin\n        if(s==1'B0)begin y=a;end\n        else begin y=b;end\n    end\nendmodule",
