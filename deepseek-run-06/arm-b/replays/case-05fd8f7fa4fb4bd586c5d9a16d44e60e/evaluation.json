      "patch_payload": {
        "candidate_id": "C_f37f4c407da485f8_1",
        "edit": "Fix malformed binary literals in the 3-to-8 decoder case statements: 3'b100 was 8'b0001_000 (7 bits) corrected to 8'b0001_0000, and 3'b111 was 8'b100_0000 (7 bits) corrected to 8'b1000_0000, so outputs for a=100 and a=111 match the one-hot oracle.",
