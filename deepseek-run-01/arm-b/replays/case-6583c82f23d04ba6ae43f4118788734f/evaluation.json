        "replacement_rtl": "module latch24_test( d, clk,q );\n\t\n\t\n\n    input[23:0] d;\n    input clk;\n    output[23:0] q;\n    reg[23:0] q;\n    always @(clk)\n        q<=d;\n\t\n\nendmodule\n",
