      "patch_payload": {
        "candidate_id": "C_6328c7b138858cb0_1",
        "edit": "Fix async reset polarity (active-low CLR) and reset width to 24 bits; replace the redundant !F_IN hold with an ENA enable guard so the counter advances on F_IN edges as intended.",
        "lens_id": "temporal_v1",
