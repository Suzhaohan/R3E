      "patch_payload": {
        "candidate_id": "C_31c7757106b77709_1",
        "edit": "In the always block, changed the nonblocking assignment Q=Q+1 to Q<=Q+1 and corrected the terminal BCD rollover comparison from Q[7:0]==8'b10000000 to Q[7:0]==8'b10011001 so the two-digit BCD counter resets after 99 instead of at 80.",
        "lens_id": "dataflow_v1",
