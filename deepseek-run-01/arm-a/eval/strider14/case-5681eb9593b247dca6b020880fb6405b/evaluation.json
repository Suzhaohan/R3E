      "patch_payload": {
        "candidate_id": "C_ffcb6f5e8d757be9_0",
        "edit": "Fix T flip-flop: correct active-low reset polarity (if (!rstn) q <= 0) and swap toggle/hold behavior so q toggles when t is high and holds when t is low.",
        "lens_id": "generic_v1",
        "replacement_rtl": "module tff (   input clk,\n               input \t  rstn,\n               input \t  t,\n               output reg q);\n   \n   always @ (posedge clk) begin\n    if (!rstn) \n      q <= 0;\n    else\n      if (t)\n        q <= ~q;\n      else\n        q <= q;\n   end\nendmodule\n",
        "slot_index": 0
