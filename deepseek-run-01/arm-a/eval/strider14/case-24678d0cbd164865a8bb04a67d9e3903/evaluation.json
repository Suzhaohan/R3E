      "patch_payload": {
        "candidate_id": "C_7c4984903633e800_0",
        "edit": "Fix active-low reset polarity: change `if (rstn)` to `if (!rstn)` so q is cleared when rstn is low.",
        "lens_id": "generic_v1",
        "replacement_rtl": "module tff (   input clk,\n               input \t  rstn,\n               input \t  t,\n               output reg q);\n   \n   always @ (posedge clk) begin\n      \n      if (!rstn)\n\t q <= 0;\n      else if (t)\n\t q <= ~q;\n      else\n\t q <= q;\n      \n   end\nendmodule\n",
        "slot_index": 0
      },
