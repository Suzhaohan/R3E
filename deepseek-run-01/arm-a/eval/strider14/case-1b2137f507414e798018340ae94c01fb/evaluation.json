      "patch_payload": {
        "candidate_id": "C_39982871abeba907_0",
        "edit": "Fix active-low reset polarity: change `if (rstn)` to `if (!rstn)` so reset clears op when rstn is low, matching the active-low reset intent and oracle behavior.",
        "lens_id": "generic_v1",
        "replacement_rtl": "module lshift_reg (input             clk,        // Clock input\n                   input            rstn,        // Active low reset input\n                   input [7:0]       load_val,   // Load value \n                   input             load_en,     // Load enable\n                   output reg [7:0] op);         // Output register value\n \n   integer i;\n \n   // At posedge of clock, if reset is low set output to 0\n   // If reset is high, load new value to op if load_en=1\n   // If reset is high, and load_en=0 shift register to left\n   always @ (posedge clk) begin\n      if (!rstn) begin\n        op <= 0;\n      end else begin\n \n        // If load_en is 1, load the value to op\n        // else keep shifting for every clock\n        if (load_en) begin\n          op <= load_val;\n        end else begin\n            for (i = 0; i < 8; i = i + 1) begin\n              op[i+1] <= op[i];\n            end\n            op[0] <= op[7];\n        end\n      end\n    end\nendmodule\n \n",
        "slot_index": 0
      },
      "patch_payload_hash": "sha256:4626066d29ab02ea16937ed6a4ff9d2783ae26ac0e51b5e08978ed3c744441c8",
      "prompt_hash": "sha256:47d6560dd7292b9a95fc86b7d585dd1162b02de950d36857a47cd74a6f6d4984",
