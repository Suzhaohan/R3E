      "patch_payload": {
        "candidate_id": "C_858fe1a522f02e85_0",
        "edit": "Change the case assignments from nonblocking to blocking so out updates in the same cycle.",
        "lens_id": "generic_v1",
        "replacement_rtl": "module mux_4to1_case ( input [3:0] a,                 // 4-bit input called a\n                       input [3:0] b,                 // 4-bit input called b\n                       input [3:0] c,                 // 4-bit input called c\n                       input [3:0] d,                 // 4-bit input called d\n                       input [1:0] sel,               // input sel used to select between a,b,c,d\n                       output reg out);               // 4-bit output based on input sel\n\n   // This always block gets executed whenever a/b/c/d/sel changes value\n   // When that happens, based on value in sel, output is assigned to either a/b/c/d\n   always @ (a or b or c or d or sel) begin\n      case (sel)\n         2'b00 : out = a;\n         2'b01 : out = b;\n         2'b10 : out = c;\n         2'b11 : out = d;\n      endcase\n   end\nendmodule",
        "slot_index": 0
      },
