nd\n\telse\n\t\tbegin\n\t\t\tcase(state)\n\t\t\t////////////////////////////////////////////////\n\t\t\t1:begin  // operation is running\n\t\t\t\tif (CE)\n\t\t\t\t\t\tbegin\n\t\t\t\t\t\t\tif(RdAdd == 187)\n\t\t\t\t\t\t\t\tbegin\n\t\t\t\t\t\t\t\t\tstate<=0;\n\t\t\t\t\t\t\t\t\tout_done<=1;\n\t\t\t\t\t\t\t\tend\n\t\t\t\t\t\t\telse\t\n\t\t\t\t\t\t\t\tRdAdd<=RdAdd+1;\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\tOut_byte<=In_byte;\n\t\t\t\t\t\t\t\tValid_out<=1;\n\t\t\t\t\t\tend\t\n\t\t\tend\n\t\t\t///////////////////////////////////////////////\n\t\t\tdefault:begin    /// idle state\n\t\t\t\tif(CE)\n\t\t\t\t\tValid_out<=0;\n\t\t\t\t\n\t\t\t\t\n\t\t\t\tout_done<=0;\n\t\t\t\t\n\t\t\t\tif(DONE)\n\t\t\t\t\tbegin\n\t\t\t\t\t\tF<=1;\n\t\t\t\t\t\tRE<=~RE;\n\t\t\t\t\t\tRdAdd<=0;\n\t\t\t\t\tend\n\t\t\t\t\n\t\t\t\tif(F && CE)\n\t\t\t\t\tbegin\n\t\t\t\t\t\tstate<=1;\n\t\t\t\t\t\tF<=0;\n\t\t\t\t\tend\n\t\t\tend\n\t\t\t/////////////////////////////////////////////////////////////////////\n\t\t\tendcase\n\t\tend\nend\n\nendmodule ",
        "slot_index": 2
      },
