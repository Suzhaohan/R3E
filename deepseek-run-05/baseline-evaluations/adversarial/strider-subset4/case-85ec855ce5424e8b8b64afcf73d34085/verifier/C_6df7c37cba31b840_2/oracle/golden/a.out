    %vpi_call/w 3 26 "$fwrite", v0x5bc90bd76590_0, "%g,%b,%b,%b\012", $time, v0x5bc90bd76910_0, v0x5bc90bd769e0_0, v0x5bc90bd76870_0 {0 0 0};
    %jmp T_3.0;
