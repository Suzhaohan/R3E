    .scope S_0x5bc90bd24190;
T_1 ;
    %delay 5, 0;
    %load/vec4 v0x5bc90bd76410_0;
    %inv;
    %store/vec4 v0x5bc90bd76410_0, 0, 1;
    %jmp T_1;
