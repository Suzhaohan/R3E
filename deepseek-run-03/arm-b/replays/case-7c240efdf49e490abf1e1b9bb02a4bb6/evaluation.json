      "patch_payload": {
        "candidate_id": "C_88abba66b6c73ab7_0",
        "edit": "In the posedge clk always block, replace the constant clear `q_reg<=0;` with the data capture `q_reg<=d;` so the register loads the input d on each clock edge instead of resetting to zero.",
        "lens_id": "generic_v1",
        "replacement_rtl": "module latch24_test( d, clk,q );\n\t\n\t\n\ninput wire [23:0] d;\ninput wire clk;\noutput wire [23:0] q;\nreg [23:0] q_reg;\nalways@(posedge clk)\nbegin\nq_reg<=d;\nend\nassign q=q_reg;\nendmodule",
        "slot_index": 0
      },
