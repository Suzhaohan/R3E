            "applied_patch": "--- a/rtl/sequence.sv\n+++ b/rtl/sequence.sv\n@@ -50,7 +50,7 @@\n         s5:\n             nstate=data?sf6:s6;\n         s6:\n-            nstate=s1;\n+            nstate=data?sf1:s1;\n         sf1:\n             nstate=sf2;\n         sf2:\n@@ -68,9 +68,9 @@\n         endcase\n end\n \n-always @(pstate or data or rst_n)\n+always @(*)\n begin\n-    if(!rst_n==1) \n+    if(!rst_n) \n \t\tbegin\n \t\t\tmatch=1'b0;\n \t\t\tnot_match = 1'b0;\n",
